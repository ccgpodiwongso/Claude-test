# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kpi_dashboard

# Authentication
JWT_SECRET=your-secure-random-string-here-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# WooCommerce - Trimlessspots.nl
WOOCOMMERCE_TRIMLESS_URL=https://trimlessspots.nl
WOOCOMMERCE_TRIMLESS_KEY=ck_your_consumer_key
WOOCOMMERCE_TRIMLESS_SECRET=cs_your_consumer_secret

# WooCommerce - BARI Verlichting
WOOCOMMERCE_BARI_URL=https://bari-verlichting.nl
WOOCOMMERCE_BARI_KEY=ck_your_consumer_key
WOOCOMMERCE_BARI_SECRET=cs_your_consumer_secret

# Mollie - Trimlessspots.nl
MOLLIE_TRIMLESS_API_KEY=live_your_api_key

# Mollie - BARI Verlichting
MOLLIE_BARI_API_KEY=live_your_api_key

# Sync Settings
SYNC_INTERVAL_MINUTES=15
DATA_RETENTION_DAYS=365
